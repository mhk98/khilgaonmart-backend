# Absolute path to store uploaded images/PDFs (banners, product images, etc).
# MUST point OUTSIDE the git-deployed app folder (Hostinger rebuilds under
# hbuilds/ on every deploy) so files survive redeploys. Leave unset locally
# to use the default ./images folder.
# Production (Hostinger, set via Node.js app Environment Variables panel):
# UPLOAD_DIR="/home/u172109161/uploads"
UPLOAD_DIR=""

# Cloudinary file storage. When all three are set, uploads go to Cloudinary
# (survive every redeploy) and UPLOAD_DIR is only used by the migration script.
# Cloudinary Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="perfectshop"

# Meta Conversions API version (provider credentials are stored from the dashboard)
META_GRAPH_API_VERSION="v23.0"


# Google Ads server-side conversion upload credentials
#আপনার কাজ শুধু Google Ads account-এ Auto-tagging ON রাখা।
# Path সাধারণত:
# Google Ads → Admin → Account settings → Auto-tagging →
# Tag the URL that people click through from my ad ON

GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Shared secret with the Next.js frontend (same value in its PROXY_SECRET).
# The backend trusts the customer IP the frontend forwards only when this matches.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=
# Reverse proxies (nginx etc.) directly in front of this backend; 0 if none.
TRUST_PROXY_HOPS=0
